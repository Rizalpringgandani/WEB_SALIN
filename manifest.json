{
  "manifest_version": 3,
  "name": "Prompt Scene Copier - Floating Widget",
  "version": "1.0.0",
  "description": "Layar mengambang untuk menyalin prompt adegan per adegan dengan indikator warna (hijau ke merah).",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Buka/Tutup Prompt Copier"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["widget.css"],
      "run_at": "document_idle"
    }
  ]
}
